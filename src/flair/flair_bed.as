table flair_bed
"the FLAIR isoform BED, BED12 and the 13 FLAIR columns, written by flair transcriptome, flair fusion, flair combine and flair isoalleles"
(
string	chrom;	"reference sequence chromosome or scaffold"
uint	chromStart;	"start position of the isoform on the chromosome"
uint	chromEnd;	"end position of the isoform on the chromosome"
string	name;	"FLAIR isoform id"
uint	score;	"read_support, clamped to the 0 to 1000 range a genome browser shades"
char[1]	strand;	"+ or - for the strand"
uint	thickStart;	"coding region start"
uint	thickEnd;	"coding region end"
uint	itemRgb;	"an RGB value of the form R,G,B, such as 255,0,0"
int	blockCount;	"the number of blocks (exons) in the BED line"
int[blockCount]	blockSizes;	"the block sizes, comma-separated, blockCount of them"
int[blockCount]	chromStarts;	"the block starts, comma-separated, blockCount of them, each relative to chromStart"
string	gene_id;	"the FLAIR gene id of the isoform"
string	ref_transcript_id;	"transcript_id of the annotation GTF, or one generated by FLAIR"
lstring	ref_gene_mappings;	"gene_ids of the annotation GTF, or the novel gene region FLAIR identified"
uint	read_support;	"number of full-length reads supporting the isoform"
string	frac_support;	"isoform reads as a fraction of its gene's reads, spliced and single exon together, and empty where it is not computed, as in the isoforms of an allele group, which is why the field is a string"
string	productivity;	"PRO (productive), PTC (premature termination codon, so unproductive), NGO (no start codon), or NST (a start codon and no stop codon)"
string	transcript_class;	"basic (most isoforms), readthrough (several adjacent genes), or fusion (from flair fusion, several genes that are not contiguous, written as two or more rows of one isoform)"
lstring	fused_genes;	"the FLAIR gene ids of the fused genes, comma-separated"
string	pos_in_fusion;	"the position of this piece in its fusion isoform, counting from 0, and empty for an isoform that is not a fusion, which is why the field is a string"
lstring	samples;	"the samples the isoform was found in, comma-separated"
string	source_isoform;	"for an allele group, the id of the isoform it was made from, which has no alleles"
string	allele_group;	"the allele group, one for each gene and set of variants, shared by the isoforms of that group"
string	aaseq_id;	"the id of the protein sequence, shared by the isoforms that produce it"
)
